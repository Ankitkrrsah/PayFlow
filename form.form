{
  "id": "loan-application-form",
  "schema": {
    "type": "default",
    "id": "loan-application-form",
    "components": [
      {
        "type": "text",
        "label": "# Loan Application Form",
        "id": "header-text"
      },
      {
        "type": "textfield",
        "key": "applicantName",
        "label": "Applicant Full Name",
        "id": "applicantName",
        "validate": {
          "required": true
        },
        "properties": {}
      },
      {
        "type": "textfield",
        "key": "applicantEmail",
        "label": "Email Address",
        "id": "applicantEmail",
        "validate": {
          "required": true,
          "pattern": "^[\\w.-]+@[\\w.-]+\\.[a-zA-Z]{2,}$"
        },
        "properties": {}
      },
      {
        "type": "textfield",
        "key": "applicantPhone",
        "label": "Phone Number",
        "id": "applicantPhone",
        "validate": {
          "required": true
        },
        "properties": {}
      },
      {
        "type": "number",
        "key": "loanAmount",
        "label": "Loan Amount (INR)",
        "id": "loanAmount",
        "validate": {
          "required": true,
          "min": 10000,
          "max": 10000000
        },
        "properties": {}
      },
      {
        "type": "select",
        "key": "loanPurpose",
        "label": "Loan Purpose",
        "id": "loanPurpose",
        "values": [
          { "label": "Home Purchase", "value": "home_purchase" },
          { "label": "Home Renovation", "value": "home_renovation" },
          { "label": "Education", "value": "education" },
          { "label": "Business", "value": "business" },
          { "label": "Vehicle", "value": "vehicle" },
          { "label": "Personal", "value": "personal" },
          { "label": "Medical", "value": "medical" },
          { "label": "Other", "value": "other" }
        ],
        "validate": {
          "required": true
        },
        "properties": {}
      },
      {
        "type": "number",
        "key": "loanTenureMonths",
        "label": "Loan Tenure (in months)",
        "id": "loanTenureMonths",
        "validate": {
          "required": true,
          "min": 6,
          "max": 360
        },
        "properties": {}
      },
      {
        "type": "number",
        "key": "annualIncome",
        "label": "Annual Income (INR)",
        "id": "annualIncome",
        "validate": {
          "required": true,
          "min": 0
        },
        "properties": {}
      },
      {
        "type": "select",
        "key": "employmentType",
        "label": "Employment Type",
        "id": "employmentType",
        "values": [
          { "label": "Salaried", "value": "salaried" },
          { "label": "Self-Employed", "value": "self_employed" },
          { "label": "Business Owner", "value": "business_owner" },
          { "label": "Retired", "value": "retired" },
          { "label": "Unemployed", "value": "unemployed" }
        ],
        "validate": {
          "required": true
        },
        "properties": {}
      },
      {
        "type": "number",
        "key": "existingEmiMonthly",
        "label": "Existing Monthly EMI Obligations (INR)",
        "id": "existingEmiMonthly",
        "validate": {
          "required": true,
          "min": 0
        },
        "description": "Total of all current monthly EMI payments",
        "properties": {}
      },
      {
        "type": "number",
        "key": "creditScore",
        "label": "Self-Declared Credit Score (CIBIL)",
        "id": "creditScore",
        "validate": {
          "required": true,
          "min": 300,
          "max": 900
        },
        "description": "Enter your CIBIL score (300-900). The system will verify this.",
        "properties": {}
      },
      {
        "type": "textarea",
        "key": "applicantAddress",
        "label": "Residential Address",
        "id": "applicantAddress",
        "validate": {
          "required": true
        },
        "properties": {}
      },
      {
        "type": "checkbox",
        "key": "declarationAccepted",
        "label": "I declare that all the information provided is accurate and complete. I authorise the bank to verify my credit history.",
        "id": "declarationAccepted",
        "validate": {
          "required": true
        },
        "properties": {}
      }
    ],
    "exporter": {
      "name": "Camunda Web Modeler",
      "version": "0.17.0"
    }
  }
}